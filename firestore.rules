rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isDeveloper() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["developer", "admin"];
    }

    function ownsExisting() {
      return signedIn() && resource.data.ownerId == request.auth.uid;
    }

    function ownsIncoming() {
      return signedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isDeveloper();

      allow create: if isSelf(userId)
        && request.resource.data.role == "user"
        && request.resource.data.uid == request.auth.uid;

      allow update: if isSelf(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.uid == resource.data.uid;

      allow update, delete: if isDeveloper();
    }

    match /studio/{docId} {
      allow read: if signedIn();
      allow write: if isDeveloper();
    }

    match /{collectionName}/{docId} {
      allow read: if collectionName in ["cases", "deadlines", "evidence", "tasks"]
        && (ownsExisting() || isDeveloper());

      allow create: if collectionName in ["cases", "deadlines", "evidence", "tasks"]
        && ownsIncoming();

      allow update, delete: if collectionName in ["cases", "deadlines", "evidence", "tasks"]
        && (ownsExisting() || isDeveloper());
    }
  }
}

